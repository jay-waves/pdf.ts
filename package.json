{
  "name": "pdf.ts",
  "license": "MIT",
  "private": true,
  "version": "0.4.5",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test:patch": "node --test tests/embedpdf-patch.test.mjs",
    "dev": "node scripts/build-chrome.mjs --watch",
    "build:chrome": "pnpm typecheck && node scripts/build-chrome.mjs",
    "build:linux": "pnpm build:web && node scripts/build-launcher.mjs linux-amd64",
    "build:windows": "pnpm build:web && node scripts/build-launcher.mjs windows-amd64",
    "build:web": "pnpm typecheck && VIEWER_PLATFORM=web vite build",
    "deploy:web": "bash scripts/deploy-web.sh",
    "build:vscode": "pnpm typecheck && node scripts/build-vscode.mjs"
  },
  "dependencies": {
    "@embedpdf/core": "2.14.4",
    "@embedpdf/engines": "2.14.4",
    "@embedpdf/models": "2.14.4",
    "@embedpdf/pdfium": "2.14.4",
    "@embedpdf/plugin-annotation": "2.14.4",
    "@embedpdf/plugin-bookmark": "2.14.4",
    "@embedpdf/plugin-document-manager": "2.14.4",
    "@embedpdf/plugin-form": "2.14.4",
    "@embedpdf/plugin-history": "2.14.4",
    "@embedpdf/plugin-interaction-manager": "2.14.4",
    "@embedpdf/plugin-print": "2.14.4",
    "@embedpdf/plugin-render": "2.14.4",
    "@embedpdf/plugin-rotate": "2.14.4",
    "@embedpdf/plugin-scroll": "2.14.4",
    "@embedpdf/plugin-search": "2.14.4",
    "@embedpdf/plugin-selection": "2.14.4",
    "@embedpdf/plugin-spread": "2.14.4",
    "@embedpdf/plugin-tiling": "2.14.4",
    "@embedpdf/plugin-viewport": "2.14.4",
    "@embedpdf/plugin-zoom": "2.14.4",
    "asn1js": "^3.0.10",
    "hash-wasm": "^4.12.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.16.0",
    "pkijs": "^3.4.0",
    "radix-ui": "^1.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.9.2",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.0",
    "yazl": "2.5.1"
  }
}
