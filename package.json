{
  "name": "pdf.ts",
  "license": "MIT",
  "private": true,
  "version": "1.1.1",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "browserslist": {
    "production": [
      "Chrome >= 152",
      "Edge >= 152",
      "Firefox >= 154",
      "Safari >= 26",
      "iOS >= 26"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "dev:wsl": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "compile": "pnpm typecheck && vite build",
    "package:chrome": "node scripts/package-chrome.mjs",
    "package:linux:binary": "node scripts/package-launcher.mjs linux-amd64",
    "package:windows:binary": "node scripts/package-launcher.mjs windows-amd64",
    "package:macos:binary": "node scripts/package-launcher.mjs darwin-arm64",
    "package:deb": "pnpm package:linux:binary && sh scripts/package-linux.sh deb",
    "package:rpm": "pnpm package:linux:binary && sh scripts/package-linux.sh rpm",
    "package:linux": "pnpm package:linux:binary && sh scripts/package-linux.sh deb && sh scripts/package-linux.sh rpm",
    "package:windows": "pnpm package:windows:binary && node scripts/package-windows.mjs",
    "package:macos": "pnpm package:macos:binary && sh scripts/package-macos.sh",
    "package:all": "pnpm package:chrome && pnpm package:linux && pnpm package:windows",
    "build:all": "pnpm compile && pnpm package:all",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@embedpdf/core": "3.0.0",
    "@embedpdf/core-annotation": "3.0.0",
    "@embedpdf/core-geometry": "3.0.0",
    "@embedpdf/engine": "3.0.0",
    "@embedpdf/engine-core": "3.0.0",
    "@embedpdf/engine-runtime": "3.0.0",
    "@embedpdf/engine-runtime-wasm32": "3.0.0",
    "@embedpdf/engine-services": "3.0.0",
    "@embedpdf/plugin-actions": "3.0.0",
    "@embedpdf/plugin-annotation": "3.0.0",
    "@embedpdf/plugin-form": "3.0.0",
    "@embedpdf/plugin-history": "3.0.0",
    "@embedpdf/plugin-interaction": "3.0.0",
    "@embedpdf/plugin-link": "3.0.0",
    "@embedpdf/plugin-render": "3.0.0",
    "@embedpdf/plugin-selection": "3.0.0",
    "@embedpdf/plugin-stage": "3.0.0",
    "@embedpdf/react": "3.0.0",
    "asn1js": "^3.0.10",
    "hash-wasm": "^4.12.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.37.0",
    "pkijs": "^3.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "yazl": "^3.3.1"
  }
