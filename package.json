{
  "name": "embedpdf-chrome-extension-wrapper",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "scripts": {
    "sync:chrome-version": "node scripts/sync-chrome-version.mjs",
    "typecheck": "tsgo --noEmit",
    "build": "pnpm build:chrome",
    "build:chrome": "pnpm typecheck && pnpm sync:chrome-version && node scripts/build-chrome.mjs",
    "build:vscode": "pnpm typecheck && node scripts/build-vscode.mjs",
    "dev": "pnpm dev:chrome",
    "dev:chrome": "pnpm sync:chrome-version && vite build --watch",
    "package": "pnpm package:chrome",
    "package:chrome": "pnpm build:chrome && node scripts/package-chrome.mjs",
    "package:vscode": "pnpm build:vscode && node scripts/package-vscode.mjs",
    "release:prepare": "pnpm package:chrome"
  },
  "dependencies": {
    "@embedpdf/core": "2.14.4",
    "@embedpdf/engines": "2.14.4",
    "@embedpdf/models": "2.14.4",
    "@embedpdf/pdfium": "2.14.4",
    "@embedpdf/plugin-annotation": "2.14.4",
    "@embedpdf/plugin-bookmark": "2.14.4",
    "@embedpdf/plugin-document-manager": "2.14.4",
    "@embedpdf/plugin-export": "2.14.4",
    "@embedpdf/plugin-form": "2.14.4",
    "@embedpdf/plugin-history": "2.14.4",
    "@embedpdf/plugin-interaction-manager": "2.14.4",
    "@embedpdf/plugin-pan": "2.14.4",
    "@embedpdf/plugin-print": "2.14.4",
    "@embedpdf/plugin-render": "2.14.4",
    "@embedpdf/plugin-rotate": "2.14.4",
    "@embedpdf/plugin-scroll": "2.14.4",
    "@embedpdf/plugin-search": "2.14.4",
    "@embedpdf/plugin-selection": "2.14.4",
    "@embedpdf/plugin-spread": "2.14.4",
    "@embedpdf/plugin-thumbnail": "2.14.4",
    "@embedpdf/plugin-tiling": "2.14.4",
    "@embedpdf/plugin-viewport": "2.14.4",
    "@embedpdf/plugin-zoom": "2.14.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
