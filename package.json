{
  "name": "pdf.ts",
  "license": "MIT",
  "private": true,
  "version": "0.8.4",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "browserslist": [
    "Chrome >= 129",
    "Edge >= 129",
    "Firefox >= 147",
    "Safari >= 26"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "compile": "pnpm typecheck && vite build",
    "package:chrome": "node scripts/package-chrome.mjs",
    "package:linux:binary": "node scripts/package-launcher.mjs linux-amd64",
    "package:windows:binary": "node scripts/package-launcher.mjs windows-amd64",
    "package:deb": "pnpm package:linux:binary && node scripts/package-linux.mjs deb",
    "package:rpm": "pnpm package:linux:binary && node scripts/package-linux.mjs rpm",
    "package:linux": "pnpm package:linux:binary && node scripts/package-linux.mjs deb && node scripts/package-linux.mjs rpm",
    "package:windows": "pnpm package:windows:binary && node scripts/package-windows-installer.mjs",
    "package:all": "pnpm package:chrome && pnpm package:linux && pnpm package:windows",
    "build:all": "pnpm compile && pnpm package:all",
    "deploy:web": "bash scripts/deploy-web.sh",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@embedpdf/core": "2.14.4",
    "@embedpdf/engines": "2.14.4",
    "@embedpdf/models": "2.14.4",
    "@embedpdf/pdfium": "2.14.4",
    "@embedpdf/plugin-annotation": "2.14.4",
    "@embedpdf/plugin-document-manager": "2.14.4",
    "@embedpdf/plugin-form": "2.14.4",
    "@embedpdf/plugin-history": "2.14.4",
    "@embedpdf/plugin-interaction-manager": "2.14.4",
    "@embedpdf/plugin-render": "2.14.4",
    "@embedpdf/plugin-rotate": "2.14.4",
    "@embedpdf/plugin-scroll": "2.14.4",
    "@embedpdf/plugin-selection": "2.14.4",
    "@embedpdf/plugin-spread": "2.14.4",
    "@embedpdf/plugin-tiling": "2.14.4",
    "@embedpdf/plugin-viewport": "2.14.4",
    "@embedpdf/plugin-zoom": "2.14.4",
    "@use-gesture/react": "^10.3.1",
    "asn1js": "^3.0.10",
    "hash-wasm": "^4.12.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.16.0",
    "pkijs": "^3.4.0",
    "radix-ui": "^1.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.0",
    "yazl": "2.5.1"
  }
}
