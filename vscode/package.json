{
  "name": "pdf-ts",
  "displayName": "PDF.ts Viewer",
  "description": "A fast PDF viewer and editor for Visual Studio Code.",
  "version": "0.0.0",
  "publisher": "jay-waves",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jay-waves/pdf.ts.git"
  },
  "files": [
    "extension.cjs",
    "icon.png",
    "README.md",
    "media/**"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCustomEditor:pdf-ts.viewer"],
  "main": "./extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdf-ts.viewer",
        "displayName": "PDF.ts Viewer",
        "selector": [{ "filenamePattern": "*.pdf" }],
        "priority": "default"
      }
    ]
  }
}
